<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gt.edu.umg.gestionescolar.controller.AsistenciaController"
      spacing="16"
      prefWidth="1100"
      prefHeight="650"
      style="-fx-background-color: #f4f7fb;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Control de asistencia"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #173567;"/>

    <Label text="Registra la presencia o ausencia de cada estudiante por curso y fecha."
           wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Buscar:"/>

        <TextField fx:id="txtBuscar"
                   promptText="Estudiante, carné, curso, fecha o estado"
                   HBox.hgrow="ALWAYS"/>

        <Button text="Limpiar búsqueda"
                onAction="#limpiarBusqueda"/>

        <Button text="Actualizar listas"
                onAction="#actualizarListas"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox spacing="12"
              prefWidth="290"
              minWidth="290"
              style="-fx-background-color: white; -fx-background-radius: 10;">

            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <Label text="Datos de asistencia"
                   style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

            <Label fx:id="lblId" text="Nuevo registro"/>

            <Label text="Estudiante"/>
            <ComboBox fx:id="cbEstudiante"
                      promptText="Seleccionar estudiante"
                      maxWidth="Infinity"/>

            <Label text="Curso"/>
            <ComboBox fx:id="cbCurso"
                      promptText="Seleccionar curso"
                      maxWidth="Infinity"/>

            <Label text="Fecha"/>
            <DatePicker fx:id="dpFecha"
                        editable="false"
                        maxWidth="Infinity"/>

            <Label text="Estado"/>
            <ComboBox fx:id="cbEstado"
                      promptText="Presente o Ausente"
                      maxWidth="Infinity"/>

            <FlowPane hgap="10" vgap="10">
                <Button text="Guardar"
                        onAction="#guardar"
                        prefWidth="115"/>

                <Button text="Actualizar"
                        onAction="#actualizar"
                        prefWidth="115"/>

                <Button text="Eliminar"
                        onAction="#eliminar"
                        prefWidth="115"/>

                <Button text="Limpiar"
                        onAction="#limpiar"
                        prefWidth="115"/>
            </FlowPane>

            <Label text="Selecciona una fila de la tabla para actualizarla o eliminarla."
                   wrapText="true"
                   style="-fx-text-fill: #526175;"/>
        </VBox>

        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Asistencias registradas"
                   style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

            <TableView fx:id="tblAsistencias" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="55"/>

                    <TableColumn fx:id="colEstudiante"
                                 text="Estudiante"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colCurso"
                                 text="Curso"
                                 prefWidth="170"/>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="100"/>
                </columns>
            </TableView>

            <Label fx:id="lblTotal" text="Total: 0 registros"/>
        </VBox>

    </HBox>
</VBox>