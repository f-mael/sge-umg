<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" stylesheets="@../styles/personas.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gt.edu.umg.gestionescolar.controller.AcademicoController">
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <!-- PESTAÑA 1: MATRÍCULA / INSCRIPCIONES -->
          <Tab text="📝 Matrícula / Inscripciones">
            <content>
              <VBox spacing="12.0">
                 <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                 </padding>
                 <children>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar">
                       <children>
                          <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔍 Buscar:" />
                          <TextField fx:id="txtInscripcionBuscar" prefWidth="360.0" promptText="Buscar por estudiante, carné o grado..." styleClass="search-field" />
                          <Button onAction="#handleLimpiarFiltroInscripcion" text="✕ Limpiar Filtro" />
                          <Pane HBox.hgrow="ALWAYS" />
                          <Label fx:id="lblInscripcionContador" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Total: 0 inscripciones" />
                       </children>
                    </HBox>
                    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                       <children>
                          <!-- Formulario Inscripción -->
                          <VBox prefWidth="360.0" spacing="12.0" styleClass="card-panel">
                             <children>
                                <Label styleClass="card-title" text="Formulario de Inscripción" />
                                <TextField fx:id="txtInscripcionId" managed="false" visible="false" />
                                <Label fx:id="lblCicloActivo" style="-fx-text-fill: #0284c7; -fx-font-weight: bold;" text="Ciclo Activo Vigente: 2026" />
                                <GridPane hgap="8.0" vgap="12.0">
                                   <children>
                                      <Label styleClass="form-label" text="Estudiante: *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                      <ComboBox fx:id="cbInscripcionEstudiante" prefWidth="220.0" promptText="-- Seleccionar Estudiante --" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                      <Label styleClass="form-label" text="Grado Asignado: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                      <ComboBox fx:id="cbInscripcionGrado" prefWidth="220.0" promptText="-- Seleccionar Grado --" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                   </children>
                                </GridPane>
                                <Pane VBox.vgrow="ALWAYS" />
                                <VBox spacing="8.0">
                                   <children>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleGuardarInscripcion" styleClass="btn, btn-guardar" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleActualizarInscripcion" styleClass="btn, btn-actualizar" text="🔄 Actualizar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleEliminarInscripcion" styleClass="btn, btn-eliminar" text="🗑️ Eliminar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleLimpiarInscripcion" styleClass="btn, btn-limpiar" text="🧹 Limpiar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                   </children>
                                </VBox>
                             </children>
                          </VBox>
                          <!-- Tabla Inscripciones -->
                          <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                             <children>
                                <Label styleClass="card-title" text="Estudiantes Inscritos en el Ciclo" />
                                <TableView fx:id="tblInscripciones" VBox.vgrow="ALWAYS">
                                  <columns>
                                    <TableColumn fx:id="colInsId" prefWidth="60.0" text="ID" />
                                    <TableColumn fx:id="colInsFecha" prefWidth="110.0" text="Fecha" />
                                    <TableColumn fx:id="colInsEstudiante" prefWidth="250.0" text="Estudiante" />
                                    <TableColumn fx:id="colInsGrado" prefWidth="200.0" text="Grado / Sección" />
                                    <TableColumn fx:id="colInsCiclo" prefWidth="90.0" text="Ciclo" />
                                  </columns>
                                  <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                  </columnResizePolicy>
                                </TableView>
                             </children>
                          </VBox>
                       </children>
                    </HBox>
                 </children>
              </VBox>
            </content>
          </Tab>

          <!-- PESTAÑA 2: CURSOS -->
          <Tab text="📚 Cursos">
            <content>
              <VBox spacing="12.0">
                 <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                 </padding>
                 <children>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar">
                       <children>
                          <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔍 Buscar:" />
                          <TextField fx:id="txtCursoBuscar" prefWidth="360.0" promptText="Buscar por nombre, docente o grado..." styleClass="search-field" />
                          <Button onAction="#handleLimpiarFiltroCurso" text="✕ Limpiar Filtro" />
                          <Pane HBox.hgrow="ALWAYS" />
                          <Label fx:id="lblCursoContador" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Total: 0 cursos" />
                       </children>
                    </HBox>
                    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                       <children>
                          <!-- Formulario Curso -->
                          <VBox prefWidth="360.0" spacing="12.0" styleClass="card-panel">
                             <children>
                                <Label styleClass="card-title" text="Datos del Curso" />
                                <TextField fx:id="txtCursoId" managed="false" visible="false" />
                                <GridPane hgap="8.0" vgap="12.0">
                                   <children>
                                      <Label styleClass="form-label" text="Nombre Curso: *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                      <TextField fx:id="txtCursoNombre" prefWidth="210.0" promptText="ej. Programación II" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                      <Label styleClass="form-label" text="Docente: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                      <ComboBox fx:id="cbCursoDocente" prefWidth="210.0" promptText="-- Asignar Docente --" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                      <Label styleClass="form-label" text="Grado / Sección: *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                      <ComboBox fx:id="cbCursoGrado" prefWidth="210.0" promptText="-- Asignar Grado --" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                   </children>
                                </GridPane>
                                <Pane VBox.vgrow="ALWAYS" />
                                <VBox spacing="8.0">
                                   <children>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleGuardarCurso" styleClass="btn, btn-guardar" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleActualizarCurso" styleClass="btn, btn-actualizar" text="🔄 Actualizar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleEliminarCurso" styleClass="btn, btn-eliminar" text="🗑️ Eliminar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleLimpiarCurso" styleClass="btn, btn-limpiar" text="🧹 Limpiar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                   </children>
                                </VBox>
                             </children>
                          </VBox>
                          <!-- Tabla Cursos -->
                          <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                             <children>
                                <Label styleClass="card-title" text="Catálogo de Cursos" />
                                <TableView fx:id="tblCursos" VBox.vgrow="ALWAYS">
                                  <columns>
                                    <TableColumn fx:id="colCursoId" prefWidth="60.0" text="ID" />
                                    <TableColumn fx:id="colCursoNombre" prefWidth="220.0" text="Nombre del Curso" />
                                    <TableColumn fx:id="colCursoDocente" prefWidth="220.0" text="Docente Asignado" />
                                    <TableColumn fx:id="colCursoGrado" prefWidth="200.0" text="Grado / Sección" />
                                  </columns>
                                  <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                  </columnResizePolicy>
                                </TableView>
                             </children>
                          </VBox>
                       </children>
                    </HBox>
                 </children>
              </VBox>
            </content>
          </Tab>

          <!-- PESTAÑA 3: GRADOS Y SECCIONES -->
          <Tab text="🏫 Grados y Secciones">
            <content>
              <VBox spacing="12.0">
                 <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                 </padding>
                 <children>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar">
                       <children>
                          <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔍 Buscar:" />
                          <TextField fx:id="txtGradoBuscar" prefWidth="360.0" promptText="Buscar por nombre, nivel o sección..." styleClass="search-field" />
                          <Button onAction="#handleLimpiarFiltroGrado" text="✕ Limpiar Filtro" />
                          <Pane HBox.hgrow="ALWAYS" />
                          <Label fx:id="lblGradoContador" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Total: 0 grados" />
                       </children>
                    </HBox>
                    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                       <children>
                          <!-- Formulario Grado -->
                          <VBox prefWidth="360.0" spacing="12.0" styleClass="card-panel">
                             <children>
                                <Label styleClass="card-title" text="Datos del Grado y Sección" />
                                <TextField fx:id="txtGradoId" managed="false" visible="false" />
                                <GridPane hgap="8.0" vgap="12.0">
                                   <children>
                                      <Label styleClass="form-label" text="Nombre: *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                      <TextField fx:id="txtGradoNombre" prefWidth="210.0" promptText="ej. Tercero Básico" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                      <Label styleClass="form-label" text="Nivel: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                      <TextField fx:id="txtGradoNivel" prefWidth="210.0" promptText="ej. Básico, Diversificado" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                      <Label styleClass="form-label" text="Sección: *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                      <TextField fx:id="txtGradoSeccion" prefWidth="210.0" promptText="ej. A, B, C" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                   </children>
                                </GridPane>
                                <Pane VBox.vgrow="ALWAYS" />
                                <VBox spacing="8.0">
                                   <children>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleGuardarGrado" styleClass="btn, btn-guardar" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleActualizarGrado" styleClass="btn, btn-actualizar" text="🔄 Actualizar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleEliminarGrado" styleClass="btn, btn-eliminar" text="🗑️ Eliminar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleLimpiarGrado" styleClass="btn, btn-limpiar" text="🧹 Limpiar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                   </children>
                                </VBox>
                             </children>
                          </VBox>
                          <!-- Tabla Grados -->
                          <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                             <children>
                                <Label styleClass="card-title" text="Listado General de Grados y Secciones" />
                                <TableView fx:id="tblGrados" VBox.vgrow="ALWAYS">
                                  <columns>
                                    <TableColumn fx:id="colGradoId" prefWidth="60.0" text="ID" />
                                    <TableColumn fx:id="colGradoNombre" prefWidth="250.0" text="Nombre del Grado" />
                                    <TableColumn fx:id="colGradoNivel" prefWidth="180.0" text="Nivel Académico" />
                                    <TableColumn fx:id="colGradoSeccion" prefWidth="100.0" text="Sección" />
                                  </columns>
                                  <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                  </columnResizePolicy>
                                </TableView>
                             </children>
                          </VBox>
                       </children>
                    </HBox>
                 </children>
              </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane>