<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1160.0" stylesheets="@../styles/personas.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gt.edu.umg.gestionescolar.controller.PersonasController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="header-title" text="🎓 Sistema de Gestión Escolar (SGE)" />
                  <Label styleClass="header-subtitle" text="Universidad Mariano Gálvez de Guatemala • Campus Cobán" />
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <TabPane fx:id="tabPanePrincipal" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <!-- PESTAÑA 1: ESTUDIANTES -->
          <Tab text="👨‍🎓 Estudiantes">
            <content>
              <VBox spacing="12.0">
                 <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                 </padding>
                 <children>
                    <!-- Barra de Búsqueda -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar">
                       <children>
                          <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔍 Buscar:" />
                          <TextField fx:id="txtEstudianteBuscar" prefWidth="380.0" promptText="Buscar por nombre, apellido, carné, email o teléfono..." styleClass="search-field" />
                          <Button onAction="#handleLimpiarBusquedaEstudiante" text="✕ Limpiar Filtro" />
                          <Pane HBox.hgrow="ALWAYS" />
                          <Label fx:id="lblEstudianteContador" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Total: 0 estudiantes" />
                       </children>
                    </HBox>
                    <!-- Contenido Principal: Formulario a la Izquierda y Grid a la Derecha -->
                    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                       <children>
                          <!-- Formulario Estudiante -->
                          <VBox prefWidth="360.0" spacing="10.0" styleClass="card-panel">
                             <children>
                                <Label styleClass="card-title" text="Datos del Estudiante" />
                                <TextField fx:id="txtEstudianteId" managed="false" visible="false" />
                                <GridPane hgap="8.0" vgap="8.0">
                                   <children>
                                      <Label styleClass="form-label" text="Carné: *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                      <TextField fx:id="txtEstudianteCarnet" promptText="ej. 0905-22-1001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                      <Label styleClass="form-label" text="Nombres: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                      <TextField fx:id="txtEstudianteNombre" promptText="Nombres del estudiante" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                      <Label styleClass="form-label" text="Apellidos: *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                      <TextField fx:id="txtEstudianteApellido" promptText="Apellidos del estudiante" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                      <Label styleClass="form-label" text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                      <TextField fx:id="txtEstudianteTelefono" promptText="ej. 5555-1234" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                      <Label styleClass="form-label" text="Correo Electrónico:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                      <TextField fx:id="txtEstudianteEmail" promptText="ej. alumno@miumg.edu.gt" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                      <Label styleClass="form-label" text="Fecha Nac.: *" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                      <DatePicker fx:id="dpEstudianteFechaNac" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                      <Label styleClass="form-label" text="Encargado:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                      <ComboBox fx:id="cbEstudianteEncargado" maxWidth="Infinity" promptText="-- Seleccionar Encargado --" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                   </children>
                                </GridPane>
                                <Pane VBox.vgrow="ALWAYS" />
                                <!-- Botonera CRUD -->
                                <VBox spacing="8.0">
                                   <children>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleGuardarEstudiante" styleClass="btn, btn-guardar" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleActualizarEstudiante" styleClass="btn, btn-actualizar" text="🔄 Actualizar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleEliminarEstudiante" styleClass="btn, btn-eliminar" text="🗑️ Eliminar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleLimpiarEstudiante" styleClass="btn, btn-limpiar" text="🧹 Limpiar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                   </children>
                                </VBox>
                             </children>
                          </VBox>
                          <!-- Grid / TableView Estudiantes -->
                          <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                             <children>
                                <Label styleClass="card-title" text="Listado General de Estudiantes" />
                                <TableView fx:id="tblEstudiantes" VBox.vgrow="ALWAYS">
                                  <columns>
                                    <TableColumn fx:id="colEstudianteId" prefWidth="45.0" text="ID" />
                                    <TableColumn fx:id="colEstudianteCarnet" prefWidth="110.0" text="Carné" />
                                    <TableColumn fx:id="colEstudianteNombre" prefWidth="125.0" text="Nombre" />
                                    <TableColumn fx:id="colEstudianteApellido" prefWidth="125.0" text="Apellido" />
                                    <TableColumn fx:id="colEstudianteTelefono" prefWidth="95.0" text="Teléfono" />
                                    <TableColumn fx:id="colEstudianteEmail" prefWidth="160.0" text="Correo Electrónico" />
                                    <TableColumn fx:id="colEstudianteFechaNac" prefWidth="100.0" text="Fecha Nac." />
                                    <TableColumn fx:id="colEstudianteEncargado" prefWidth="140.0" text="Encargado Asignado" />
                                  </columns>
                                  <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                  </columnResizePolicy>
                                </TableView>
                             </children>
                          </VBox>
                       </children>
                    </HBox>
                 </children>
              </VBox>
            </content>
          </Tab>

          <!-- PESTAÑA 2: DOCENTES -->
          <Tab text="👨‍🏫 Docentes">
            <content>
              <VBox spacing="12.0">
                 <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                 </padding>
                 <children>
                    <!-- Barra de Búsqueda -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar">
                       <children>
                          <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔍 Buscar:" />
                          <TextField fx:id="txtDocenteBuscar" prefWidth="380.0" promptText="Buscar por código, nombre, apellido, especialidad..." styleClass="search-field" />
                          <Button onAction="#handleLimpiarBusquedaDocente" text="✕ Limpiar Filtro" />
                          <Pane HBox.hgrow="ALWAYS" />
                          <Label fx:id="lblDocenteContador" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Total: 0 docentes" />
                       </children>
                    </HBox>
                    <!-- Contenido Principal -->
                    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                       <children>
                          <!-- Formulario Docente -->
                          <VBox prefWidth="360.0" spacing="10.0" styleClass="card-panel">
                             <children>
                                <Label styleClass="card-title" text="Datos del Docente" />
                                <TextField fx:id="txtDocenteId" managed="false" visible="false" />
                                <GridPane hgap="8.0" vgap="8.0">
                                   <children>
                                      <Label styleClass="form-label" text="Código Empleado: *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                      <TextField fx:id="txtDocenteCodigo" promptText="ej. DOC-101" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                      <Label styleClass="form-label" text="Nombres: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                      <TextField fx:id="txtDocenteNombre" promptText="Nombres del docente" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                      <Label styleClass="form-label" text="Apellidos: *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                      <TextField fx:id="txtDocenteApellido" promptText="Apellidos del docente" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                      <Label styleClass="form-label" text="Especialidad: *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                      <TextField fx:id="txtDocenteEspecialidad" promptText="ej. Programación, Redes, etc." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                      <Label styleClass="form-label" text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                      <TextField fx:id="txtDocenteTelefono" promptText="ej. 5555-4321" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                      <Label styleClass="form-label" text="Correo Electrónico:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                      <TextField fx:id="txtDocenteEmail" promptText="ej. docente@profesor.umg.edu.gt" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                   </children>
                                </GridPane>
                                <Pane VBox.vgrow="ALWAYS" />
                                <!-- Botonera CRUD -->
                                <VBox spacing="8.0">
                                   <children>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleGuardarDocente" styleClass="btn, btn-guardar" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleActualizarDocente" styleClass="btn, btn-actualizar" text="🔄 Actualizar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleEliminarDocente" styleClass="btn, btn-eliminar" text="🗑️ Eliminar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleLimpiarDocente" styleClass="btn, btn-limpiar" text="🧹 Limpiar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                   </children>
                                </VBox>
                             </children>
                          </VBox>
                          <!-- Grid / TableView Docentes -->
                          <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                             <children>
                                <Label styleClass="card-title" text="Listado General de Docentes" />
                                <TableView fx:id="tblDocentes" VBox.vgrow="ALWAYS">
                                  <columns>
                                    <TableColumn fx:id="colDocenteId" prefWidth="45.0" text="ID" />
                                    <TableColumn fx:id="colDocenteCodigo" prefWidth="110.0" text="Código" />
                                    <TableColumn fx:id="colDocenteNombre" prefWidth="130.0" text="Nombre" />
                                    <TableColumn fx:id="colDocenteApellido" prefWidth="130.0" text="Apellido" />
                                    <TableColumn fx:id="colDocenteEspecialidad" prefWidth="160.0" text="Especialidad" />
                                    <TableColumn fx:id="colDocenteTelefono" prefWidth="100.0" text="Teléfono" />
                                    <TableColumn fx:id="colDocenteEmail" prefWidth="160.0" text="Correo Electrónico" />
                                  </columns>
                                  <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                  </columnResizePolicy>
                                </TableView>
                             </children>
                          </VBox>
                       </children>
                    </HBox>
                 </children>
              </VBox>
            </content>
          </Tab>

          <!-- PESTAÑA 3: ENCARGADOS -->
          <Tab text="👥 Encargados">
            <content>
              <VBox spacing="12.0">
                 <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                 </padding>
                 <children>
                    <!-- Barra de Búsqueda -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar">
                       <children>
                          <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔍 Buscar:" />
                          <TextField fx:id="txtEncargadoBuscar" prefWidth="380.0" promptText="Buscar por CUI, nombre, apellido, parentesco..." styleClass="search-field" />
                          <Button onAction="#handleLimpiarBusquedaEncargado" text="✕ Limpiar Filtro" />
                          <Pane HBox.hgrow="ALWAYS" />
                          <Label fx:id="lblEncargadoContador" style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Total: 0 encargados" />
                       </children>
                    </HBox>
                    <!-- Contenido Principal -->
                    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                       <children>
                          <!-- Formulario Encargado -->
                          <VBox prefWidth="360.0" spacing="10.0" styleClass="card-panel">
                             <children>
                                <Label styleClass="card-title" text="Datos del Encargado" />
                                <TextField fx:id="txtEncargadoId" managed="false" visible="false" />
                                <GridPane hgap="8.0" vgap="8.0">
                                   <children>
                                      <Label styleClass="form-label" text="CUI (DPI): *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                      <TextField fx:id="txtEncargadoCui" promptText="13 dígitos numéricos" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                      <Label styleClass="form-label" text="Nombres: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                      <TextField fx:id="txtEncargadoNombre" promptText="Nombres del encargado" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                      <Label styleClass="form-label" text="Apellidos: *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                      <TextField fx:id="txtEncargadoApellido" promptText="Apellidos del encargado" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                      <Label styleClass="form-label" text="Parentesco: *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                      <ComboBox fx:id="cbEncargadoParentesco" maxWidth="Infinity" promptText="Seleccionar o escribir..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                      <Label styleClass="form-label" text="Dirección: *" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                      <TextField fx:id="txtEncargadoDireccion" promptText="Zona, Municipio, Departamento" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                      <Label styleClass="form-label" text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                      <TextField fx:id="txtEncargadoTelefono" promptText="ej. 5555-9876" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                      <Label styleClass="form-label" text="Correo Electrónico:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                      <TextField fx:id="txtEncargadoEmail" promptText="ej. encargado@correo.com" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                   </children>
                                </GridPane>
                                <Pane VBox.vgrow="ALWAYS" />
                                <!-- Botonera CRUD -->
                                <VBox spacing="8.0">
                                   <children>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleGuardarEncargado" styleClass="btn, btn-guardar" text="💾 Guardar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleActualizarEncargado" styleClass="btn, btn-actualizar" text="🔄 Actualizar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                      <HBox spacing="8.0">
                                         <children>
                                            <Button maxWidth="Infinity" onAction="#handleEliminarEncargado" styleClass="btn, btn-eliminar" text="🗑️ Eliminar" HBox.hgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleLimpiarEncargado" styleClass="btn, btn-limpiar" text="🧹 Limpiar" HBox.hgrow="ALWAYS" />
                                         </children>
                                      </HBox>
                                   </children>
                                </VBox>
                             </children>
                          </VBox>
                          <!-- Grid / TableView Encargados -->
                          <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                             <children>
                                <Label styleClass="card-title" text="Listado General de Encargados" />
                                <TableView fx:id="tblEncargados" VBox.vgrow="ALWAYS">
                                  <columns>
                                    <TableColumn fx:id="colEncargadoId" prefWidth="45.0" text="ID" />
                                    <TableColumn fx:id="colEncargadoCui" prefWidth="120.0" text="CUI (DPI)" />
                                    <TableColumn fx:id="colEncargadoNombre" prefWidth="120.0" text="Nombre" />
                                    <TableColumn fx:id="colEncargadoApellido" prefWidth="120.0" text="Apellido" />
                                    <TableColumn fx:id="colEncargadoParentesco" prefWidth="90.0" text="Parentesco" />
                                    <TableColumn fx:id="colEncargadoTelefono" prefWidth="95.0" text="Teléfono" />
                                    <TableColumn fx:id="colEncargadoEmail" prefWidth="150.0" text="Correo Electrónico" />
                                    <TableColumn fx:id="colEncargadoDireccion" prefWidth="150.0" text="Dirección" />
                                  </columns>
                                  <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                  </columnResizePolicy>
                                </TableView>
                             </children>
                          </VBox>
                       </children>
                    </HBox>
                 </children>
              </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane>
